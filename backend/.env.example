# Cadena de conexión de MongoDB Atlas. Nunca subas el .env real al repositorio.
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.mongodb.net/?retryWrites=true&w=majority

# Base de datos de esta aplicación (distinta a la de Pawnee).
MONGODB_DB=diario_gamer

# Puerto del servidor Express. En Render esta variable la inyecta la plataforma.
PORT=3000

# Orígenes del frontend separados por coma, sin barra final.
# Local ya está permitido además de esta lista.
# En producción pon la URL pública del static site, por ejemplo:
# CORS_ORIGIN=https://diario-gamer-web.onrender.com
# Usa * solo si quieres reflejar cualquier origen.
CORS_ORIGIN=http://localhost:5173
